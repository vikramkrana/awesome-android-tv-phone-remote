+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.drawable.Drawable;
+import android.graphics.Rect;
+import android.os.SystemClock;
+import android.view.View;
+
+/**
+ * A slowly moving mesh gradient: a few soft colour blobs drift over a dark base, like the ambient backdrops of
+ * macOS and Apple TV. It is computed on the CPU into a tiny 160x90 bitmap ten times a second and stretched to
+ * the screen with bilinear filtering, which smooths it into a gradient; no image files, shaders or blur.
+ * Runs only while Home is on screen (start/stop).
+ */
+final class MeshGradientView extends View {
+    private static final int W = 160, H = 90;
+    private static final long STEP_MS = 100L;
+
+    /** Dark base and blob colours: deep, so the white clock, names and pills keep their contrast. */
+    private static final int BASE = 0xFF05060D;
+    private static final int[] COLORS = {
+            0xFF2B1B6B,   // indigo
+            0xFF0E4D6E,   // deep teal
+            0xFF5A1A5E,   // plum
+            0xFF123A8C,   // blue
+            0xFF6B2A3A,   // wine
+    };
+    /** Per blob: orbit centre x/y, orbit radius x/y (all 0..1 of the screen), periods in seconds, phase, size. */
+    private static final float[][] ORBITS = {
+            {0.25f, 0.30f, 0.20f, 0.18f, 71f, 53f, 0.0f, 0.55f},
+            {0.75f, 0.35f, 0.22f, 0.20f, 89f, 61f, 1.3f, 0.60f},
+            {0.55f, 0.80f, 0.30f, 0.15f, 67f, 97f, 2.1f, 0.50f},
+            {0.15f, 0.85f, 0.18f, 0.22f, 101f, 79f, 3.7f, 0.45f},
+            {0.85f, 0.75f, 0.15f, 0.25f, 83f, 109f, 4.4f, 0.40f},
+    };
+
+    /** Fast steps while the colours cross-fade to a new app's palette, so the change looks fluid. */
+    private static final long FADE_STEP_MS = 33L;
+    private static final long FADE_MS = 1200L;
+
+    /** Blob colours on screen now, the palette they fade from and to, and when that fade began (0 = none). */
+    private final int[] colors = COLORS.clone();
+    private final int[] fromColors = COLORS.clone();
+    private final int[] toColors = COLORS.clone();
+    private long fadeStart;
+    private String paletteKey = "";
+    private final java.util.Map<String, int[]> paletteCache = new java.util.HashMap<>();
+
+    private final Bitmap bitmap = Bitmap.createBitmap(W, H, Bitmap.Config.ARGB_8888);
+    private final int[] pixels = new int[W * H];
+    private final Paint paint = new Paint(Paint.FILTER_BITMAP_FLAG | Paint.DITHER_FLAG);
+    private final Rect src = new Rect(0, 0, W, H);
+    private final Rect dst = new Rect();
+    private final float[] bx = new float[ORBITS.length], by = new float[ORBITS.length];
+    private final long origin = SystemClock.uptimeMillis();
+    private boolean running;
+    private final Runnable tick = new Runnable() {
+        @Override public void run() {
+            if (!running) return;
+            boolean fading = advanceFade();
+            render();
+            invalidate();
+            postDelayed(this, fading ? FADE_STEP_MS : STEP_MS);
+        }
+    };
+
+    MeshGradientView(Context context) {
+        super(context);
+        setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);
+        setFocusable(false);
+        render();
+    }
+
+    void start() {
+        if (running) return;
+        running = true;
+        post(tick);
+    }
+
+    void stop() {
+        running = false;
+        removeCallbacks(tick);
+    }
+
+    /**
+     * Fades the blobs to colours taken from the focused app's artwork. key identifies the app, so focusing the same
+     * tile again (layout passes call this repeatedly) neither restarts the fade nor samples the artwork again.
+     */
+    void followApp(String key, Drawable artwork, int accent) {
+        if (key == null || key.equals(paletteKey)) return;
+        paletteKey = key;
+        int[] palette = paletteCache.get(key);
+        if (palette == null) {
+            palette = paletteFrom(artwork, accent);
+            paletteCache.put(key, palette);
+        }
+        System.arraycopy(colors, 0, fromColors, 0, colors.length);
+        System.arraycopy(palette, 0, toColors, 0, toColors.length);
+        fadeStart = SystemClock.uptimeMillis();
+        if (running) {
+            removeCallbacks(tick);
+            post(tick);
+        } else {
+            // Home not on screen yet (first focus at start): show the palette at once.
+            System.arraycopy(palette, 0, colors, 0, colors.length);
+            fadeStart = 0;
+            render();
+            invalidate();
+        }
+    }
+
+    /** One step of the colour fade; false once there is none running. */
+    private boolean advanceFade() {
+        if (fadeStart == 0) return false;
+        float t = Math.min(1f, (SystemClock.uptimeMillis() - fadeStart) / (float) FADE_MS);
+        float e = t * t * (3f - 2f * t);
+        for (int i = 0; i < colors.length; i++) colors[i] = mix(fromColors[i], toColors[i], e);
+        if (t >= 1f) fadeStart = 0;
+        return true;
+    }
+
+    private static int mix(int a, int b, float t) {
+        int r = Math.round(((a >> 16) & 0xFF) + (((b >> 16) & 0xFF) - ((a >> 16) & 0xFF)) * t);
+        int g = Math.round(((a >> 8) & 0xFF) + (((b >> 8) & 0xFF) - ((a >> 8) & 0xFF)) * t);
+        int bl = Math.round((a & 0xFF) + ((b & 0xFF) - (a & 0xFF)) * t);
+        return 0xFF000000 | (r << 16) | (g << 8) | bl;
+    }
+
+    /**
+     * Five blob colours from an app's banner or icon: the most vivid colour of each quarter of the artwork plus the
+     * launcher's accent for the app. A quarter with no real colour (white, grey or black areas) takes the accent
+     * with its hue turned a little, so a mostly white banner still gives a rich, single-hue mesh. All are darkened
+     * so the clock, the names and the white pills stay readable over them.
+     */
+    static int[] paletteFrom(Drawable live, int accent) {
+        int[] out = new int[COLORS.length];
+        int[] vivid = {0, 0, 0, 0};
+        if (live != null) {
+            Drawable d = live.getConstantState() != null ? live.getConstantState().newDrawable().mutate() : live;
+            Rect saved = new Rect(d.getBounds());
+            int n = 16;
+            Bitmap bmp = Bitmap.createBitmap(n, n / 2, Bitmap.Config.ARGB_8888);
+            Canvas c = new Canvas(bmp);
+            d.setBounds(0, 0, n, n / 2);
+            d.draw(c);
+            d.setBounds(saved);
+            int[] px = new int[n * n / 2];
+            bmp.getPixels(px, 0, n, 0, 0, n, n / 2);
+            bmp.recycle();
+            float[] best = new float[4];
+            for (int y = 0; y < n / 2; y++) {
+                for (int x = 0; x < n; x++) {
+                    int p = px[y * n + x];
+                    if (((p >>> 24) & 0xFF) < 128) continue;   // transparent corners of an icon
+                    int q = (y < n / 4 ? 0 : 2) + (x < n / 2 ? 0 : 1);
+                    int pr = (p >> 16) & 0xFF, pg = (p >> 8) & 0xFF, pb = p & 0xFF;
+                    int max = Math.max(pr, Math.max(pg, pb)), min = Math.min(pr, Math.min(pg, pb));
+                    float sat = max == 0 ? 0f : (max - min) / (float) max;
+                    float score = sat * Math.min(1f, max / 255f * 1.4f);
+                    if (score > best[q]) {
+                        best[q] = score;
+                        vivid[q] = p;
+                    }
+                }
+            }
+            for (int q = 0; q < 4; q++) if (best[q] < 0.3f) vivid[q] = 0;
+        }
+        float[] hsv = new float[3];
+        for (int i = 0; i < 4; i++) {
+            int source = vivid[i] != 0 ? vivid[i] : accent;
+            Color.colorToHSV(source, hsv);
+            if (vivid[i] == 0) hsv[0] = (hsv[0] + (i - 1.5f) * 18f + 360f) % 360f;   // a family of hues
+            out[i] = deepen(hsv);
+        }
+        Color.colorToHSV(accent, hsv);
+        out[4] = deepen(hsv);
+        return out;
+    }
+
+    /** Dark and rich: enough colour to read as the app, dark enough for white text on top. */
+    private static int deepen(float[] hsv) {
+        hsv[1] = Math.max(0.55f, Math.min(0.9f, hsv[1]));
+        hsv[2] = Math.max(0.28f, Math.min(0.46f, hsv[2] * 0.55f));
+        return Color.HSVToColor(hsv);
+    }
+
+    private void render() {
+        float seconds = (SystemClock.uptimeMillis() - origin) / 1000f;
+        for (int i = 0; i < ORBITS.length; i++) {
+            float[] o = ORBITS[i];
+            bx[i] = (o[0] + o[2] * (float) Math.sin(2 * Math.PI * seconds / o[4] + o[6])) * W;
+            by[i] = (o[1] + o[3] * (float) Math.cos(2 * Math.PI * seconds / o[5] + o[6] * 0.7f)) * H;
+        }
+        int baseR = (BASE >> 16) & 0xFF, baseG = (BASE >> 8) & 0xFF, baseB = BASE & 0xFF;
+        for (int y = 0; y < H; y++) {
+            for (int x = 0; x < W; x++) {
+                float r = baseR, g = baseG, b = baseB;
+                for (int i = 0; i < ORBITS.length; i++) {
+                    float dx = (x - bx[i]) / W, dy = (y - by[i]) / H * 0.5625f;   // keep blobs round on 16:9
+                    float size = ORBITS[i][7];
+                    float w = 1f - (dx * dx + dy * dy) / (size * size * 0.25f);
+                    if (w <= 0f) continue;
+                    w = w * w * (3f - 2f * w);   // smoothstep falloff: soft edges, no rings
+                    int c = colors[i];
+                    r += (((c >> 16) & 0xFF) - r) * w * 0.85f;
+                    g += (((c >> 8) & 0xFF) - g) * w * 0.85f;
+                    b += ((c & 0xFF) - b) * w * 0.85f;
+                }
+                pixels[y * W + x] = 0xFF000000 | ((int) r << 16) | ((int) g << 8) | (int) b;
+            }
+        }
+        bitmap.setPixels(pixels, 0, W, 0, 0, W, H);
+    }
+
+    @Override protected void onDraw(Canvas canvas) {
+        dst.set(0, 0, getWidth(), getHeight());
+        canvas.drawBitmap(bitmap, src, dst, paint);
+    }
+
+    @Override protected void onDetachedFromWindow() {
+        stop();
+        super.onDetachedFromWindow();
+    }
+}
