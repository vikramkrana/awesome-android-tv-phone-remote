<?xml version="1.0" encoding="utf-8"?>
<!-- Focus, scroll and window changes only: which screen is showing, whether Home scrolled under the card, and the text box a typed search goes into. Key filtering
     only while a touch-only app (config.xml touch_apps, e.g. Netflix's phone app) is in front: its arrows and OK
     drive a highlight ring and taps (TouchNav.java); keys are not stored.
     no screen content is sent anywhere, except the screen preview: a small picture for paired phones, only while the owner
     has switched it on in the app (off by default). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewFocused|typeViewScrolled|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagReportViewIds|flagRequestFilterKeyEvents"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:canRequestFilterKeyEvents="true"
    android:canTakeScreenshot="true"
    android:notificationTimeout="200"
    android:description="@string/service_description" />
