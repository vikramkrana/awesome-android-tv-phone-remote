<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon: the mark on a dark rounded tile. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="40dp" />
            <gradient android:startColor="#FF26272B" android:endColor="#FF101012" android:angle="270" />
            <size android:width="192dp" android:height="192dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_mark" />
</layer-list>
