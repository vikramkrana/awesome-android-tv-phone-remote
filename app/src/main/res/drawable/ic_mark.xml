<?xml version="1.0" encoding="utf-8"?>
<!-- The app's mark, on a transparent ground: a screen, the signal reaching it, and the remote's own round dial.
     One source for the launcher icon, the TV banner and the phone's Home Screen icon (WebServer draws it to PNG). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="192dp" android:height="192dp"
    android:viewportWidth="192" android:viewportHeight="192">
    <!-- screen -->
    <path
        android:pathData="M42,32 H150 a12,12 0 0 1 12,12 V104 a12,12 0 0 1 -12,12 H42 a12,12 0 0 1 -12,-12 V44 a12,12 0 0 1 12,-12 Z"
        android:strokeColor="#FF8E9099" android:strokeWidth="7" android:strokeLineJoin="round" />
    <!-- signal -->
    <path android:pathData="M74.7,69.1 A26,26 0 0 1 117.3,69.1"
        android:strokeColor="#FFF4F2F8" android:strokeWidth="6.5" android:strokeLineCap="round" />
    <path android:pathData="M84.5,78 A14,14 0 0 1 107.5,78"
        android:strokeColor="#FFF4F2F8" android:strokeWidth="6.5" android:strokeLineCap="round" />
