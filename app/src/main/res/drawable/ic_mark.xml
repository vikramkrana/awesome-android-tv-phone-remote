    <path android:pathData="M48,130 a48,48 0 1 0 96,0 a48,48 0 1 0 -96,0 Z" android:fillColor="#FF141416" />
    <path android:pathData="M55,130 a41,41 0 1 0 82,0 a41,41 0 1 0 -82,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="68" android:startY="92" android:endX="126" android:endY="168">
                <item android:offset="0" android:color="#FFA3A4AC" />
                <item android:offset="0.55" android:color="#FF4B4C53" />
                <item android:offset="1" android:color="#FF2C2D31" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M78,130 a18,18 0 1 0 36,0 a18,18 0 1 0 -36,0 Z" android:fillColor="#FF1B1C1F" />
    <path android:fillColor="#FFF4F2F8"
        android:pathData="M93,100.5 a3,3 0 1 0 6,0 a3,3 0 1 0 -6,0 Z M93,159.5 a3,3 0 1 0 6,0 a3,3 0 1 0 -6,0 Z M63.5,130 a3,3 0 1 0 6,0 a3,3 0 1 0 -6,0 Z M122.5,130 a3,3 0 1 0 6,0 a3,3 0 1 0 -6,0 Z" />
